<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color layer (transparent) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red_text" />
            <corners android:radius="70dp" /> <!-- Adjust the corner radius as needed -->
        </shape>
    </item>

    <!-- Border layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red_text" />
            <stroke
                android:width="2dp"
                android:color="@color/red_text" /> <!-- Adjust the border width and color as needed -->
            <corners android:radius="70dp" /> <!-- Match the corner radius of the background layer -->
        </shape>
    </item>
</layer-list>