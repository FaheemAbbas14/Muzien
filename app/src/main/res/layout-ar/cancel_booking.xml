<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:minHeight="400dp"
    android:background="@drawable/white_rounded10"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="25dp"
    android:paddingTop="16dp"
    android:paddingEnd="25dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/thumb_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:src="@drawable/cancle_booking_icon" />

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_weight="700"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:text="@string/cancel_booking"
        android:textColor="@color/red_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="400"
        android:fontFamily="@font/manrope_regular"
        android:gravity="center"
        android:text="@string/are_you_sure_you_want_to_n_cancel_the_booking"
        android:textColor="@color/black_shade1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="30dp"
        android:background="@color/light_grey_border"
        android:text="" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">

        <LinearLayout
            android:id="@+id/llOpening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white_grey"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <EditText
                android:id="@+id/edtReason"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center|right"
                android:hint="@string/provide_reason"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:textColor="@color/colorTextDefault"
                android:textFontWeight="400"
                android:textSize="14sp" />


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="-10dp"
            android:background="@color/white"
            android:fontFamily="@font/manrope_regular"
            android:inputType="textEmailAddress"
            android:text="@string/provide_reason"
            android:textColor="@color/colorTextLabelDefault"
            android:textFontWeight="500"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@+id/llOpening"
            app:layout_constraintStart_toStartOf="@+id/llOpening" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_white_blue"
            android:paddingStart="27dp"
            android:paddingTop="14dp"
            android:paddingEnd="27dp"
            android:paddingBottom="14dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary" />

        <Button
            android:id="@+id/proceed_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_red_100"
            android:paddingStart="17dp"
            android:paddingTop="14dp"
            android:paddingEnd="17dp"
            android:paddingBottom="14dp"
            android:text="@string/yes_proceed"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
