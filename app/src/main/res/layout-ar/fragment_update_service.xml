<?xml version="1.0" encoding="utf-8"?>
<com.tt.muzien.utilities.CustomSwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<androidx.core.widget.NestedScrollView
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey"
    android:fillViewport="true"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_Cover"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="0dp"
                android:background="@color/light_grey"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scaleType="centerCrop"
                android:src="@drawable/hair_cut"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/txtItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_bold"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/textBlack"
                android:textFontWeight="700"
                android:textSize="22sp"
                app:layout_constraintEnd_toStartOf="@+id/imgEdit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_Cover" />

            <TextView
                android:id="@+id/txtItemCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/black_shade1"
                android:textFontWeight="400"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/imgEdit"
                app:layout_constraintStart_toStartOf="@+id/txtItemName"
                app:layout_constraintTop_toBottomOf="@+id/txtItemName" />

            <TextView
                android:id="@+id/txtItemDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/black_shade1"
                android:textFontWeight="400"
                android:textSize="12sp"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toStartOf="@+id/imgEdit"
                app:layout_constraintStart_toStartOf="@+id/txtItemName"
                app:layout_constraintTop_toBottomOf="@+id/txtItemCategory" />


            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/circular_white"
                android:paddingStart="7dp"
                android:paddingTop="8dp"
                android:paddingEnd="7dp"
                android:paddingBottom="8dp"
                android:src="@drawable/blue_right_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/white_rounded10"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                app:layout_constraintEnd_toEndOf="@+id/imgEdit"
                app:layout_constraintStart_toStartOf="@+id/txtItemName"
                app:layout_constraintTop_toBottomOf="@+id/txtItemDuration">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_regular"
                    android:text="@string/select_the_salons_where_you_would_like_to_activate_the_service"
                    android:textColor="@color/black_shade1"
                    android:textFontWeight="700"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcySaloons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rounded_blue_100"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="50dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="@+id/imgEdit"
                app:layout_constraintStart_toStartOf="@+id/txtItemCategory"
                app:layout_constraintTop_toBottomOf="@+id/llList">

                <TextView
                    android:id="@+id/txtSave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="@string/update"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="17dp"
                android:src="@drawable/grey_edit"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/txtItemName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txtItemName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</com.tt.muzien.utilities.CustomSwipeRefreshLayout>
