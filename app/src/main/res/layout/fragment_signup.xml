<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="25dp"
            android:paddingTop="20dp"
            android:paddingRight="25dp"

            android:background="@color/white"
            tools:context=".ui.auth.FragmentSignup">

            <!-- TODO: Update blank fragment layout -->


            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="Account Information"
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgProfilePic"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="60dp"
                android:background="@drawable/circuler_grey"
                android:src="@drawable/user_placeholder"
                app:civ_border_color="@color/white"
                app:civ_border_width="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView5" />

            <ImageView
                android:id="@+id/imgCamera"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-45dp"
                android:layout_marginBottom="-5dp"
                android:background="@drawable/circular_blue"
                android:padding="5dp"
                android:src="@drawable/camera"
                app:layout_constraintBottom_toBottomOf="@+id/imgProfilePic"
                app:layout_constraintStart_toEndOf="@+id/imgProfilePic" />

            <LinearLayout
                android:id="@+id/llFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/rounded_white_grey"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgCamera">


                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/manrope_regular"
                    android:gravity="center|left"
                    android:hint="John Smith"
                    android:inputType="text"
                    android:paddingRight="10dp"
                    android:textColor="@color/colorTextDefault"
                    android:textFontWeight="600"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="-10dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Full Name"
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="13sp"
                app:layout_constraintBottom_toTopOf="@+id/llFullName"
                app:layout_constraintStart_toStartOf="@+id/llFullName" />

            <TextView
                android:id="@+id/txtNameError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Enter full name"
                android:textColor="@color/red_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/llFullName"
                app:layout_constraintTop_toBottomOf="@+id/llFullName" />

            <LinearLayout
                android:id="@+id/llEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/rounded_white_grey"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="@+id/llFullName"
                app:layout_constraintStart_toStartOf="@+id/llFullName"
                app:layout_constraintTop_toBottomOf="@+id/llFullName">


                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/manrope_regular"
                    android:gravity="center|left"
                    android:hint="Smith@gmail.com"
                    android:inputType="text"
                    android:paddingRight="10dp"
                    android:textColor="@color/colorTextDefault"
                    android:textFontWeight="600"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="-10dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:inputType="textEmailAddress"
                android:text="Email"
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="13sp"
                app:layout_constraintBottom_toTopOf="@+id/llEmail"
                app:layout_constraintStart_toStartOf="@+id/llEmail" />

            <TextView
                android:id="@+id/txtEmailError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Enter valid email"
                android:textColor="@color/red_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/llEmail"
                app:layout_constraintTop_toBottomOf="@+id/llEmail" />

            <TextView
                android:id="@+id/textviewRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Select your role"
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="@+id/llEmail"
                app:layout_constraintStart_toStartOf="@+id/llEmail"
                app:layout_constraintTop_toBottomOf="@+id/llEmail" />

            <TextView
                android:id="@+id/textviewRoleDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/manrope_regular"
                android:text="Lorem Ipsum is simply dummy text of the printing and type setting industry."
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="@+id/textviewRole"
                app:layout_constraintStart_toStartOf="@+id/textviewRole"
                app:layout_constraintTop_toBottomOf="@+id/textviewRole" />

            <RadioGroup
                android:id="@+id/rdoRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="@+id/textviewRoleDesc"
                app:layout_constraintStart_toStartOf="@+id/textviewRoleDesc"
                app:layout_constraintTop_toBottomOf="@+id/textviewRoleDesc">

                <RadioButton
                    android:id="@+id/RdoOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_white_grey"
                    android:button="@drawable/custom_radio_widget"
                    android:drawablePadding="8dp"
                    android:paddingStart="8dp"
                    android:text="Business\nOwner" />

                <RadioButton
                    android:id="@+id/rdoProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_white_grey"
                    android:button="@drawable/custom_radio_widget"
                    android:drawablePadding="8dp"
                    android:paddingStart="8dp"
                    android:text="Service\nProvider" />

            </RadioGroup>

            <TextView
                android:id="@+id/txtRoleError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Select a role"
                android:textColor="@color/red_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/rdoRole"
                app:layout_constraintTop_toBottomOf="@+id/rdoRole" />

            <LinearLayout
                android:id="@+id/llCountry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/rounded_white_grey"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/rdoRole"
                app:layout_constraintStart_toStartOf="@+id/rdoRole"
                app:layout_constraintTop_toBottomOf="@+id/rdoRole">


                <com.hbb20.CountryCodePicker
                    android:id="@+id/country_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|left"
                    app:ccp_showFlag="true"
                    app:ccp_showFullName="true"
                    app:ccp_showNameCode="false"
                    app:ccp_showPhoneCode="false"
                    app:ccp_textGravity="LEFT" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtCountryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="-10dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Country"
                android:textColor="@color/colorTextLabelDefault"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/llCountry"
                app:layout_constraintStart_toStartOf="@+id/llCountry" />

            <TextView
                android:id="@+id/txtCountryError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@color/white"
                android:fontFamily="@font/manrope_regular"
                android:text="Select a country"
                android:textColor="@color/red_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/llCountry"
                app:layout_constraintTop_toBottomOf="@+id/llCountry" />

            <LinearLayout
                android:id="@+id/llSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/rounded_blue_100"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="50dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="@+id/rdoRole"
                app:layout_constraintStart_toStartOf="@+id/rdoRole"
                app:layout_constraintTop_toBottomOf="@+id/llCountry">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>