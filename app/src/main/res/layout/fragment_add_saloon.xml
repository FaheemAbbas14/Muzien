<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/back_button"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/manrope_regular"
            android:text="Back"
            android:textColor="@color/black"
            android:textFontWeight="700"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="38dp"
            tools:layout_editor_absoluteY="21dp" />


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:background="@color/light_grey"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/llBack"
        app:layout_constraintTop_toBottomOf="@+id/llBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgPhoto"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/doted_blue_border"
                    android:paddingStart="30dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="15dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/add_image_placeholder" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cnstInformation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/white_rounded10"
                    android:paddingStart="10dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintEnd_toEndOf="@id/imgPhoto"
                    app:layout_constraintStart_toStartOf="@id/imgPhoto"
                    app:layout_constraintTop_toBottomOf="@+id/imgPhoto">

                    <TextView
                        android:id="@+id/txtInformation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Information"
                        android:textColor="@color/black_text"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/llName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_white_grey"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtInformation">


                        <EditText
                            android:id="@+id/edtName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center|left"
                            android:hint="ABC"
                            android:inputType="text"
                            android:paddingRight="10dp"
                            android:textColor="@color/colorTextDefault"
                            android:textFontWeight="400"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="-10dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:inputType="textEmailAddress"
                        android:text="Saloon Name"
                        android:textColor="@color/colorTextLabelDefault"
                        android:textFontWeight="500"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toTopOf="@+id/llName"
                        app:layout_constraintStart_toStartOf="@+id/llName" />

                    <TextView
                        android:id="@+id/txtNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Enter valid name"
                        android:textColor="@color/red_text"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="@+id/llName"
                        app:layout_constraintTop_toBottomOf="@+id/llName" />

                    <LinearLayout
                        android:id="@+id/llPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_white_grey"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/llName">


                        <com.hbb20.CountryCodePicker
                            android:id="@+id/country_spinner"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            app:ccp_showFlag="true"
                            app:ccp_showFullName="false"
                            app:ccp_showNameCode="false"
                            app:ccp_showPhoneCode="false" />

                        <TextView
                            android:id="@+id/txtCountryCode"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center"
                            android:hint="+966"
                            android:inputType="phone"
                            android:textColor="@color/colorTextDefault"
                            android:textFontWeight="600"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/edtPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center|left"
                            android:hint=""
                            android:inputType="phone"
                            android:paddingRight="10dp"
                            android:textColor="@color/colorTextDefault"
                            android:textFontWeight="600"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="-10dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Contact Number"
                        android:textColor="@color/colorTextLabelDefault"
                        android:textFontWeight="500"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toTopOf="@+id/llPhone"
                        app:layout_constraintStart_toStartOf="@+id/llPhone" />

                    <TextView
                        android:id="@+id/txtPhoneError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Enter valid Phone number"
                        android:textColor="@color/red_text"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="@+id/llPhone"
                        app:layout_constraintTop_toBottomOf="@+id/llPhone" />

                    <LinearLayout
                        android:id="@+id/llDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_white_grey"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/llPhone">


                        <EditText
                            android:id="@+id/edtDescription"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center|left"
                            android:hint="ABC"
                            android:inputType="text"
                            android:paddingRight="10dp"
                            android:textColor="@color/colorTextDefault"
                            android:textFontWeight="400"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="-10dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:inputType="textEmailAddress"
                        android:text="Description"
                        android:textColor="@color/colorTextLabelDefault"
                        android:textFontWeight="500"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toTopOf="@+id/llDescription"
                        app:layout_constraintStart_toStartOf="@+id/llDescription" />

                    <TextView
                        android:id="@+id/txtDescriptionError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:background="@color/white"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Enter valid description"
                        android:textColor="@color/red_text"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="@+id/llDescription"
                        app:layout_constraintTop_toBottomOf="@+id/llDescription" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cnstLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/white_rounded10"
                    android:paddingStart="10dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintEnd_toEndOf="@id/imgPhoto"
                    app:layout_constraintStart_toStartOf="@id/imgPhoto"
                    app:layout_constraintTop_toBottomOf="@+id/cnstInformation">

                    <TextView
                        android:id="@+id/txtLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Salon Location"
                        android:textColor="@color/black_text"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/imgEditLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/txtLocation"
                        app:srcCompat="@drawable/edit_icon" />

                    <LinearLayout
                        android:id="@+id/llSelectLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/rounded_blue_100"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="50dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtLocation">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:text="Select Location"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Rd. 2121 Alamal Dist. 12643 Riyadh SA"
                        android:textColor="@color/black_shade2"
                        android:textFontWeight="400"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtLocation" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cnstCertificate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/white_rounded10"
                    android:paddingStart="10dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintEnd_toEndOf="@id/imgPhoto"
                    app:layout_constraintStart_toStartOf="@id/imgPhoto"
                    app:layout_constraintTop_toBottomOf="@+id/cnstLocation">

                    <TextView
                        android:id="@+id/txtCertificate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Salon Certificate"
                        android:textColor="@color/black_text"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cnstCertificateData"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="15dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtCertificate">

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="left"
                            android:text="File name.pdf"
                            android:textColor="@color/black_shade1"
                            android:textFontWeight="400"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@+id/imgIcon"
                            app:layout_constraintEnd_toStartOf="@+id/imgMinus"
                            app:layout_constraintStart_toEndOf="@+id/imgIcon"
                            app:layout_constraintTop_toTopOf="@+id/imgIcon" />

                        <ImageView
                            android:id="@+id/imgMinus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintBottom_toBottomOf="@+id/txtTiming"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/txtTitle"
                            app:srcCompat="@drawable/minus_circle" />

                        <TextView
                            android:id="@+id/txtTiming"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/manrope_regular"
                            android:text="Uploaded on 10:00 AM - 11:00 PM"
                            android:textColor="@color/black_shade2"
                            android:textFontWeight="400"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/imgMinus"
                            app:layout_constraintStart_toStartOf="@+id/txtTitle"
                            app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

                        <ImageView
                            android:id="@+id/imgIcon"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/rounded_blue_10"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/pdf_placeholder" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ImageView
                        android:id="@+id/imgCertificate"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:visibility="visible"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/doted_blue_border"
                        android:paddingStart="30dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="30dp"
                        android:paddingBottom="15dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/upload_certificate_placeholder"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtCertificate" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cnstWorkingHours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/white_rounded10"
                    android:paddingStart="10dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintEnd_toEndOf="@id/imgPhoto"
                    app:layout_constraintStart_toStartOf="@id/imgPhoto"
                    app:layout_constraintTop_toBottomOf="@+id/cnstCertificate">

                    <TextView
                        android:id="@+id/txtWorkingHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Work Hours"
                        android:textColor="@color/black_text"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyWorkingHours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/txtWorkingHours"
                        app:layout_constraintTop_toBottomOf="@+id/txtWorkingHours" />

                    <ImageView
                        android:id="@+id/imgAddWorkingHour"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/blue_add"
                        app:layout_constraintStart_toStartOf="@+id/rcyWorkingHours"
                        app:layout_constraintTop_toBottomOf="@+id/rcyWorkingHours" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cnstHolidays"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/white_rounded10"
                    android:paddingStart="10dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/cnstWorkingHours"
                    app:layout_constraintStart_toStartOf="@+id/cnstWorkingHours"
                    app:layout_constraintTop_toBottomOf="@+id/cnstWorkingHours">

                    <TextView
                        android:id="@+id/txtHoliday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Holidays"
                        android:textColor="@color/black_text"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/txtHolidaysData"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="No holiday added"
                        android:textColor="@color/black_shade2"
                        android:textFontWeight="500"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/txtHoliday"
                        app:layout_constraintTop_toBottomOf="@+id/txtHoliday" />

                    <ImageView
                        android:id="@+id/imgAddHoliday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/blue_add"
                        app:layout_constraintStart_toStartOf="@+id/txtHolidaysData"
                        app:layout_constraintTop_toBottomOf="@+id/txtHolidaysData" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtPrivacy"
                    android:layout_width="336dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/manrope_regular"
                    android:gravity="center"
                    android:text="By continuing you agree to our TC and Privacy Policy"
                    android:textColor="@color/colorTextLabelDefault"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cnstHolidays" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.9"
            android:background="@drawable/rounded_white_blue"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Cancel"
            android:textColor="@color/colorPrimary"
            android:textFontWeight="700"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="4.9"
            android:background="@drawable/rounded_blue_100"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Continue"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>