<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:minHeight="200dp"
    android:background="@drawable/white_rounded10"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="25dp"
    android:paddingTop="16dp"
    android:paddingEnd="25dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/thumb_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:src="@drawable/completed_icon" />

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_weight="700"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:text="@string/completed_nsuccessfully"
        android:textColor="@color/blue_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="400"
        android:fontFamily="@font/manrope_regular"
        android:gravity="center"
        android:text="@string/the_booking_as_been_marked_ncompleted_successfully"
        android:textColor="@color/black_shade1"
        android:textSize="14sp" />



</LinearLayout>
