<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed" />

    <RadioGroup
        android:id="@+id/rdoHomeTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Custom Radio Buttons -->
        <RadioButton
            android:id="@+id/rdoAnalytics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
           android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:padding="5dp"
            android:fontFamily="@font/manrope_regular"
            android:background="@drawable/blue_rounded"
            android:button="@android:color/transparent"
            android:checked="true"
            android:gravity="center"
            android:text="Analytics"
            android:textSize="14sp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rdoSaloons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_regular"
            android:background="@drawable/rounded_grey"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:text="Saloon(4)"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/colorTextLabelDefault" />

        <RadioButton
            android:id="@+id/rdoMembers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:padding="3dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_regular"
            android:background="@drawable/rounded_grey"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:text="Members(4)"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/colorTextLabelDefault" />

        <RadioButton
            android:id="@+id/rdoServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:padding="3dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/manrope_regular"
            android:background="@drawable/rounded_grey"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:text="Services"
            android:textSize="14sp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/colorTextLabelDefault" />

    </RadioGroup>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rdoHomeTabs" />


</androidx.constraintlayout.widget.ConstraintLayout>