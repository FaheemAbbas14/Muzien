<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/white_rounded10"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/thumb_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:src="@drawable/add_service_thumb"
        app:tint="@color/green_text" />

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_weight="700"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:text="Service Added\n Successfully"
        android:textColor="@color/green_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="45dp"
        android:layout_weight="400"
        android:fontFamily="@font/manrope_regular"
        android:gravity="center"
        android:text="Would you like to enable the\n service for salons?"
        android:textColor="@color/black_shade1"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/not_now_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="27dp"
            android:paddingEnd="27dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_white_blue"
            android:text="Not Now"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary" />

        <Button
            android:id="@+id/proceed_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_green_100"
            android:text="Yes, Proceed"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
